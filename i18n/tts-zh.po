#: mods/starcraft/ui/tts.txt:7696
msgctxt "7696@mods/starcraft/ui"
msgid "Nuclear blast"
msgstr "核弹爆炸"

#: mods/starcraft/ui/tts.txt:7697
msgctxt "7697@mods/starcraft/ui"
msgid "Yamato blast"
msgstr "大和炮轰击"

#: mods/starcraft/ui/tts.txt:7698
