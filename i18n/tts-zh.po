msgid "Destroy the Hatchery, then sacrifice a Drone for an Extractor on the lingering creep."
msgstr "摧毁主巢，在残留菌毯上工蜂献身建造萃取房。"

#: mods/starcraft/ui/tts.txt:7324
msgctxt "7324@mods/starcraft/ui"
msgid "Hatchery paints creep within seven squares and it spreads outward each second. The far square needs a few seconds before you can build. After the pool is done, destroy the Hatchery and build an Extractor on the creep that remains."
msgstr "主巢在七格内铺设菌毯，每秒向外蔓延。远处格子需等待数秒才能建造。孵化池完工后摧毁主巢，在残留菌毯上建造萃取房。"

#: mods/starcraft/ui/tts.txt:7330
msgctxt "7330@mods/starcraft/ui"
msgid "Terran: Addon"
msgstr "人族：附属建筑"

#: mods/starcraft/ui/tts.txt:7331
msgctxt "7331@mods/starcraft/ui"
msgid "Build a Tech Lab on your Barracks."
msgstr "在兵营上建造科技实验室。"

#: mods/starcraft/ui/tts.txt:7332
msgctxt "7332@mods/starcraft/ui"
msgid "Terran addon test complete."
msgstr "人族附属建筑测试完成。"

#: mods/starcraft/ui/tts.txt:7340
msgctxt "7340@mods/starcraft/ui"
msgid "Terran: Addon Recombine"
msgstr "人族：附件重组"

#: mods/starcraft/ui/tts.txt:7341
msgctxt "7341@mods/starcraft/ui"
msgid "Build Tech Lab on Barracks, lift Barracks, lift Factory. Tab the Tech Lab, go, land to reattach, then train a Tank."
msgstr "在兵营建造科技实验室，起飞兵营与工厂。Tab 科技实验室、退格 go、降落对接，再训练攻城坦克。"

#: mods/starcraft/ui/tts.txt:7342
msgctxt "7342@mods/starcraft/ui"
msgid "Terran recombine test complete."
msgstr "人族附件重组测试完成。"

#: mods/starcraft/ui/tts.txt:7350
msgctxt "7350@mods/starcraft/ui"
msgid "Go to the Tech Lab first, then land to reattach the addon."
msgstr "需要靠近科技实验室再降落才能对接。"

#: mods/starcraft/ui/tts.txt:7360
msgctxt "7360@mods/starcraft/ui"
msgid "StarCraft AI multiplayer test"
msgstr "星际 AI 联机测试"

#: mods/starcraft/ui/tts.txt:7361
msgctxt "7361@mods/starcraft/ui"
msgid "Enable the starcraft mod and pick terran, protoss, or zerg. Invite easy or aggressive computers to fill empty slots and watch psi, creep, addons, and recombine."
msgstr "启用 starcraft 模组，选择人族、神族或异虫阵营。邀请简单或积极电脑填满空位，观察能量场、菌毯、附属建筑与重组。"

#: mods/starcraft/ui/tts.txt:7370
msgctxt "7370@mods/starcraft/ui"
msgid "StarCraft: Minerals and Vespene"
msgstr "星际：矿物与瓦斯"

#: mods/starcraft/ui/tts.txt:7371
msgctxt "7371@mods/starcraft/ui"
msgid "Build an Assimilator on the vespene geyser, then gather 8 vespene back to your Nexus."
msgstr "在瓦斯气泉上建造吸收塔，并将 8 单位高能瓦斯运回主基地。"

#: mods/starcraft/ui/tts.txt:7372
msgctxt "7372@mods/starcraft/ui"
msgid "Minerals and vespene test complete."
msgstr "矿物与瓦斯测试完成。"

