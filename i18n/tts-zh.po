#: res/single/nathan tech campaign 1/ui/tts.txt:56001
msgctxt "56001@res/single/nathan tech campaign 1/ui"
msgid "gather 3000 gold,"
msgstr "收集3000黄金，"

#: res/single/nathan tech campaign 1/ui/tts.txt:56002
msgctxt "56002@res/single/nathan tech campaign 1/ui"
msgid "gather 600 wood, and"
msgstr "收集600木材，并且"

#: res/single/nathan tech campaign 1/ui/tts.txt:56003
msgctxt "56003@res/single/nathan tech campaign 1/ui"
msgid "horse and cart"
msgstr "马车"

#: res/single/nathan tech campaign 1/ui/tts.txt:56004
msgctxt "56004@res/single/nathan tech campaign 1/ui"
msgid "finally, put the resources in the cart"
msgstr "最后，把资源装上马车"

#: res/single/nathan tech campaign 1/ui/tts.txt:56007
msgctxt "56007@res/single/nathan tech campaign 1/ui"
msgid "recruit 30 footman"
msgstr "招募30名步兵"

#: res/single/nathan tech campaign 1/ui/tts.txt:56008
msgctxt "56008@res/single/nathan tech campaign 1/ui"
msgid "go to j10 by following the path"
msgstr "沿着道路前往J10"

#: res/single/nathan tech campaign 1/ui/tts.txt:56009
msgctxt "56009@res/single/nathan tech campaign 1/ui"
msgid "clear the way for Galahan"
msgstr "为加拉汉清除道路"

#: res/single/nathan tech campaign 1/ui/tts.txt:56010
msgctxt "56010@res/single/nathan tech campaign 1/ui"
msgid "show one of his peasants how to get to your castle"
msgstr "向他的一个农民展示如何到达你的城堡"

#: res/single/nathan tech campaign 1/ui/tts.txt:56011
msgctxt "56011@res/single/nathan tech campaign 1/ui"
msgid "The commander wants you to set an example. Build 30 cannon tower, 30 guard tower and recruit 60 footman."
msgstr "指挥官想让你树立榜样。建造30座加农炮塔、30座警戒塔，并招募60名步兵。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56012
msgctxt "56012@res/single/nathan tech campaign 1/ui"
msgid "Send in a spy."
msgstr "派出一名间谍。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56013
msgctxt "56013@res/single/nathan tech campaign 1/ui"
msgid "Strenthen the defenses on the eastern sides. 50 knight, 50 footman, 50 archer, 50 catapult and 10 mages should be placed in f1 on the high ground."
msgstr "加强东侧防御。在F1高地部署50名骑士、50名步兵、50名弓箭手、50辆投石车和10名法师。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56014
msgctxt "56014@res/single/nathan tech campaign 1/ui"
msgid "Take down the enemy!"
msgstr "击败敌人！"

#: res/single/nathan tech campaign 1/ui/tts.txt:56015
msgctxt "56015@res/single/nathan tech campaign 1/ui"
msgid "Time to prepare our counter attack. Get 50 knights to d1."
msgstr "是时候准备反击了。派50名骑士前往D1。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56016
msgctxt "56016@res/single/nathan tech campaign 1/ui"
msgid "Alright. Lets show them who's boss!"
msgstr "好了。让他们见识一下谁才是老大！"

#: res/single/nathan tech campaign 1/ui/tts.txt:56017
msgctxt "56017@res/single/nathan tech campaign 1/ui"
msgid "Pay off Galahan. Gather the gold and wood, then stick it in a big cart."
msgstr "给加拉汉送钱。收集黄金和木材，然后把它们装进一辆大车里。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56018
msgctxt "56018@res/single/nathan tech campaign 1/ui"
msgid "Give him his honour guard. 50 knights and 50 footman should do it."
msgstr "给他配上仪仗护卫。50名骑士和50名步兵应该够了。"

#: res/single/nathan tech campaign 1/ui/tts.txt:56019
msgctxt "56019@res/single/nathan tech campaign 1/ui"
msgid "huge transportation cart"
msgstr "大型运输车"

