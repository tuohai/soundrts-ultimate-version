#: mods/starcraft/ui/tts.txt:7382
msgctxt "7382@mods/starcraft/ui"
msgid "Tech tree test complete."
msgstr "科技树测试完成。"

#: mods/starcraft/ui/tts.txt:7393
msgctxt "7393@mods/starcraft/ui"
msgid "Nexus psi reaches about 18 meters. Each Pylon adds 12 meters. Four Pylons chained from the Nexus can power square f1; warp a Gateway there."
