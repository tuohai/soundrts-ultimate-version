#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76000
msgctxt "76000@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Prologue."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76001
msgctxt "76001@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Vous êtes un Seigneur au service du roi Conrad."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76010
msgctxt "76010@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Chapitre 1 : une nouvelle base."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76011
msgctxt "76011@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Vous disposez de quelques serfs pour explorer la carte et trouver un lieu idéal afin de prélever des ressources. Construisez un châtelet, faites le nécessaire pour le faire évoluer en donjon et recruter 5 arbalétriers afin de sécuriser les lieux."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76012
msgctxt "76012@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Avoir un donjon et 5 arbalétriers."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76013
msgctxt "76013@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Oh, voyez un peu là en A3, il y a des prairies et des ressources, et c'est exactement ce qu'il vous faut !"
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76020
msgctxt "76020@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Chapitre 2 : un ennemi invisible."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76021
msgctxt "76021@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Le roi Conrad vous a envoyé en urgence afin de résoudre une étrange affaire qui terrorise les habitants. On soupçonne que des diables et des fantomes hantent la région à la recherche de victimes. Trouver le moyen de détecter la présence de ces entités et détruisez-les."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76022
msgctxt "76022@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Trouver et neutraliser tous les fantomes."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76030
msgctxt "76030@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Chapitre 3 : le repaire des fantomes."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76031
msgctxt "76031@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Vous avez réussi à écarter la menace des fantomes mais vous avez appris que ceux-ci possèdaient un repaire dans une forêt. Muni d'une petite armée, vous vous êtes rendus sur place et vous allez maintenant devoir parcourir la forêt à la recherche de la base ennemie."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76032
msgctxt "76032@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Détruire le repaire des fantomes."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76033
msgctxt "76033@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Oh ! Regardez là ! Un manoir hanté est en i6 ! C'est sans nul doute le repaire des fantomes !"
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76040
msgctxt "76040@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Chapitre 4 : la revanche des ténèbres."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76041
msgctxt "76041@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Furieux et assoifés de vengeance, des fantomes rescapés de votre offensive ont décidé de faire appel aux forces du mal. Goules, squelettes, liches et autres nécromanciens ont répondu à l'appel et s'apprêtent à vous attaquer. Ils sont beaucoup trop nombreux pour que vous puissiez les neutraliser, aussi vous allez devoir simplement organiser votre défense jusqu'à l'arrivée des renforts envoyés par le roi Conrad."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76042
msgctxt "76042@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Résister à l'ennemi jusqu'à l'arrivée des renforts."
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76043
msgctxt "76043@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Tenez bon ! Les renforts sont à mi-chemin ! Courage !"
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76044
msgctxt "76044@mods/crazyMod9beta10/single/crazyMod_traditional/ui"
msgid "Les renforts sont maintenant très proches ! Encore un dernier effort avant la libération !"
msgstr ""

#: mods/crazyMod9beta10/single/crazyMod_traditional/ui/tts.txt:76400
